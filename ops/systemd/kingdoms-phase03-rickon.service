# Install into ~/.config/systemd/user/ only after explicit operator approval.
[Unit]
Description=Kingdoms Phase 03 Rickon headless WS01 victim session
Documentation=https://github.com/daviosardinha/GOAD_NOMAD/blob/kingdoms/phase03-overlay/docs/kingdoms-phase03-runtime-checkpoint.md
# WS01 is intentionally rebooted/logged off by lifecycle validation. Keep the
# two-minute retry backoff below, but do not permanently suppress supervised
# recovery after repeated expected disconnects.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/bash %h/Documents/GOAD_NOMAD/scripts/phase03/rickon-headless.sh
Restart=always
RestartSec=120
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
